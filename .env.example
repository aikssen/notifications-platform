# =====================================================================
# Copy to .env before running `make up`.
# Everything here is a LOCAL DEVELOPMENT value. In production these come
# from a secret manager and are injected at runtime — never from a file
# in the repository.
# =====================================================================

# --- PostgreSQL ------------------------------------------------------
POSTGRES_DB=notifications
POSTGRES_USER=notifications
POSTGRES_PASSWORD=notifications
POSTGRES_PORT=5432
DATABASE_URL=postgres://notifications:notifications@localhost:5432/notifications?sslmode=disable

# --- Kafka -----------------------------------------------------------
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_DISPATCH=notifications.dispatch
KAFKA_TOPIC_RESULT=notifications.delivery-result
KAFKA_TOPIC_DLQ=notifications.dlq
KAFKA_DISPATCH_PARTITIONS=3
KAFKA_CONSUMER_GROUP=notifications-dispatch

# --- Observability ---------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOG_LEVEL=info

# --- Service ports ---------------------------------------------------
SUBSCRIPTION_SERVICE_PORT=3001
SELF_SERVICE_PORT=3002
MONITOR_SERVICE_PORT=3003
DEMO_TOOLS_PORT=3004
DISPATCH_METRICS_PORT=9101
RETRY_METRICS_PORT=9102

# --- Security --------------------------------------------------------
# HS256 signing key for the self-service / subscription APIs.
JWT_SECRET=local-development-only-change-me
JWT_ISSUER=notifications-platform
JWT_AUDIENCE=notifications-api
JWT_TTL_SECONDS=3600

# SSRF guard. In local demos the client webhook is plain HTTP on localhost,
# which the production policy forbids — these two switches make that explicit
# instead of silently weakening the validator.
WEBHOOK_REQUIRE_HTTPS=true
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# --- Delivery behaviour ----------------------------------------------
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_SYNC_MAX_ATTEMPTS=3
WEBHOOK_SYNC_BASE_DELAY_MS=200
WEBHOOK_SYNC_MAX_DELAY_MS=2000

# --- Asynchronous retry ----------------------------------------------
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=10
RETRY_MAX_DELAY_SECONDS=900
RETRY_POLL_INTERVAL_SECONDS=5
RETRY_BATCH_SIZE=50

# --- Self-service repository adapter ---------------------------------
# postgres | file  — switching this proves the hexagonal boundary is real.
EVENTS_REPOSITORY=postgres
FIXTURE_PATH=./fixtures/notification_events.json
